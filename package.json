{
  "name": "stokku",
  "version": "1.0.0",
  "private": true,
  "description": "StokKu - monitoring stok gudang (React + Express + Prisma/SQLite)",
  "scripts": {
    "install:all": "npm install && npm --prefix server install && npm --prefix client install",
    "dev": "concurrently -n server,client -c cyan,magenta \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "npm --prefix server run dev",
    "dev:client": "npm --prefix client run dev",
    "db:migrate": "npm --prefix server run db:migrate",
    "db:seed": "npm --prefix server run db:seed",
    "db:reset": "npm --prefix server run db:reset",
    "build": "npm --prefix client run build",
    "start": "npm --prefix server start",
    "start:produksi": "npm --prefix server run start:produksi"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
